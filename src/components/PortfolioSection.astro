---
import clubreservaImg from "../assets/clubreserva.png";
import raunassImg from "../assets/CorporaciónRaunass.avif";
import appexImg from "../assets/appexgym.avif";
import floreriaImg from "../assets/lading-floreria.avif";

const projects = [
  {
    id: 1,
    title: "SaaS E-commerce Club Reserva",
    description:
      "Plataforma SaaS integral de e-commerce con panel administrativo, carritos dinámicos y pasarelas de pago.",
    demoLink: "https://clubreserva.com/yuki",
    demoText: "Caso de Éxito: Tienda Yuki",
    image: clubreservaImg,
    link: "https://clubreserva.com/",
    tags: ["PHP", "Laravel", "React", "Livewire", "MySQL"],
    color: "#FF8C00",
  },
  {
    id: 2,
    title: "Corporación Raunass",
    description:
      "Plataforma web integral para servicios de ingeniería y construcción.",
    image: raunassImg,
    link: "https://corporacionraunass.vercel.app",
    tags: ["HTML", "CSS", "JS", "Astro"],
    color: "#00D2FF",
  },
  {
    id: 3,
    title: "Appex Gym",
    description:
      "Landing page para gimnasio con sistema de membresías y diseño dinámico.",
    image: appexImg,
    link: "https://appexgym.netlify.app/",
    tags: ["HTML", "CSS", "JS", "Astro"],
    color: "#FDC830",
  },
  {
    id: 4,
    title: "Landing Page Florería",
    description:
      "Sitio web elegante para florería con catálogo de productos y carrito visual.",
    image: floreriaImg,
    link: "https://landing-floreria-xi.vercel.app/",
    tags: ["HTML", "CSS", "JS", "Responsivo"],
    color: "#00F260",
  }
];
---

<section class="portfolio section-padding" id="portfolio">
  <div class="container">
    <div class="text-center mb-5 fade-up">
      <span class="section-tag section-tag-orange">Portafolio</span>
      <h2 class="section-title">
        Algunos de mis <span class="text-gradient-orange">Mejores Trabajos</span
        >
      </h2>
    </div>

    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <div
            class="project-card fade-up"
            style={`animation-delay: ${index * 0.1}s; --accent: var(--color-orange)`}
          >
            <div class="project-image">
              <img src={project.image.src} alt={project.title} loading="lazy" />
              <div class="project-overlay project-overlay-orange">
                <a
                  href={project.link}
                  target="_blank"
                  class="view-btn view-btn-orange"
                >
                  Ver Detalles
                </a>
              </div>
            </div>
            <div class="project-info">
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="tag tag-orange">{tag}</span>
                ))}
              </div>
              <h3 class="project-title">{project.title}</h3>
              <p class="project-desc">{project.description}</p>
              {project.demoLink && (
                <a href={project.demoLink} target="_blank" class="demo-link">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  {project.demoText}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 3rem;
  }

  .project-card {
    background: var(--bg-card);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .project-card:hover {
    transform: translateY(-15px);
    border-color: var(--color-orange);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
  }

  .project-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .project-card:hover .project-image img {
    transform: scale(1.1);
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }

  .project-overlay-orange {
    background: linear-gradient(to top, rgba(251, 146, 60, 0.4), transparent);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .view-btn {
    padding: 1rem 2rem;
    background: white;
    color: var(--bg-dark);
    text-decoration: none;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.9rem;
    transform: translateY(20px);
    transition: all 0.4s ease 0.1s;
  }

  .view-btn-orange:hover {
    background: var(--color-orange);
    color: white;
  }

  .project-card:hover .view-btn {
    transform: translateY(0);
  }

  .project-info {
    padding: 2.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .tags {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 15px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 100px;
    color: var(--text-dim);
    border: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .tag-orange {
    color: var(--color-orange);
  }

  .project-card:hover .tag {
    border-color: var(--color-orange);
    background: rgba(251, 146, 60, 0.1);
  }

  .project-title {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: white;
    font-weight: 800;
  }

  .project-desc {
    color: var(--text-dim);
    line-height: 1.7;
    font-size: 1rem;
    margin-bottom: auto;
  }

  .demo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .demo-link:hover {
    opacity: 0.8;
  }

  .text-center {
    text-align: center;
  }
  .mb-5 {
    margin-bottom: 4rem;
  }

  .section-tag-orange {
    color: var(--color-orange);
  }

  .text-gradient-orange {
    background: linear-gradient(90deg, var(--color-orange), #f97316);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  @media (max-width: 576px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .project-image {
      height: 220px;
    }
  }
</style>
