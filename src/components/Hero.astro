---
import { Icon } from 'astro-icon/components';
---
<section class="hero" id="home">
  <div class="container hero-inner">
    <div class="hero-text fade-up">
      <span class="greeting">Hola, soy</span>
      <h1 class="name">Daniel<br/><span class="last-name">Cochachi</span></h1>
      <p class="role">Desarrollador Full Stack & <span class="highlight">Especialista en IA</span></p>
      
      <div class="hero-cta">
        <a href="#portfolio" class="btn btn-primary">Ver mi trabajo</a>
        <a href="#contact" class="btn btn-outline">Hablemos</a>
      </div>
    </div>

    <div class="hero-image-side fade-up-d1">
      <div class="image-wrapper">
        <div class="bg-circle-glow"></div>
        <div class="profile-circle">
          <img src="/src/assets/foto-perfil.avif" alt="Daniel Cochachi" class="hero-img" />
        </div>
        
        <div class="tech-badge-hero shimmer">
          <Icon name="lucide:sparkles" class="badge-icon" />
          <span class="badge-text">Potenciado con IA</span>
        </div>
      </div>
    </div>
  </div>
  
  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 100px;
    background: transparent;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  .greeting {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-cyan);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    display: block;
  }

  .name {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.85;
    font-weight: 900;
    color: white;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: -2px;
  }

  .last-name {
    color: var(--color-cyan);
    -webkit-text-stroke: 1px var(--color-cyan);
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 10px rgba(0, 210, 255, 0.3));
  }

  .role {
    font-size: 1.25rem;
    color: var(--text-dim);
    margin-bottom: 3rem;
    max-width: 500px;
    line-height: 1.5;
  }

  .highlight {
    color: white;
    font-weight: 700;
  }

  .hero-cta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--border);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 100px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.4s ease;
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-cyan);
    transform: translateY(-5px);
  }

  /* Large Circular Profile */
  .hero-image-side {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .image-wrapper {
    position: relative;
    width: clamp(400px, 45vw, 600px);
    height: clamp(400px, 45vw, 600px);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bg-circle-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background: var(--color-cyan);
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: pulse 8s infinite alternate;
  }

  .profile-circle {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(0, 210, 255, 0.3);
    padding: 15px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .image-wrapper:hover .hero-img {
    transform: scale(1.05);
  }

  .tech-badge-hero {
    position: absolute;
    bottom: 40px;
    right: 0;
    background: rgba(15, 20, 30, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 14px 28px;
    border-radius: 100px;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    z-index: 10;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .badge-icon {
    font-size: 1.3rem;
    color: var(--color-cyan);
  }

  .badge-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: white;
    letter-spacing: 1px;
  }

  /* Animations */
  @keyframes pulse {
    from { transform: scale(1); opacity: 0.15; }
    to { transform: scale(1.1); opacity: 0.25; }
  }

  .shimmer::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: skewX(-25deg);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    0% { left: -100%; }
    100% { left: 200%; }
  }

  @keyframes scroll {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(15px); opacity: 0; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fade-up { animation: fadeUp 1s ease forwards; }
  .fade-up-d1 { animation: fadeUp 1s ease 0.3s forwards; opacity: 0; }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.5;
  }

  .mouse {
    width: 26px;
    height: 42px;
    border: 2px solid var(--text-dim);
    border-radius: 15px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .wheel {
    width: 4px;
    height: 8px;
    background: var(--color-cyan);
    border-radius: 2px;
    animation: scroll 2s infinite;
  }

  @media (max-width: 992px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; gap: 4rem; }
    .hero-text { order: 2; }
    .hero-image-side { order: 1; }
    .image-wrapper { width: 320px; height: 320px; }
    .hero-cta { justify-content: center; }
  }
</style>
