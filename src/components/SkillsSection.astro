---
const mainSkills = [
  { name: 'Backend con Java y Spring Boot', level: 90 },
  { name: 'Bases de Datos (SQL Server / MySQL / PostgreSQL)', level: 85 },
  { name: 'Uso básico de Docker y Git', level: 60 },
  { name: 'Complemento Frontend (HTML / CSS / JS)', level: 80 },
];

const secondarySkills = ['Java', 'Spring Boot', 'SQL Server', 'MySQL', 'PostgreSQL', 'Git', 'Docker', 'HTML5', 'CSS3', 'JavaScript', 'Astro'];

const stats = [
  { label: 'Proyectos', value: '7+' },
  { label: 'Tecnologías', value: '8+' },
  { label: 'Aprendizaje', value: '100%' },
  { label: 'Pasión', value: '∞' },
];
---

<section class="skills section-padding" id="skills">
  <div class="container">
    <div class="skills-grid">
      <!-- Left: Skills -->
      <div class="skills-content fade-up">
        <span class="section-tag section-tag-emerald">Especialidad</span>
        <h2 class="section-title">Mis Habilidades <span class="text-gradient-emerald">Técnicas</span></h2>
        
        <div class="skills-bars">
          {mainSkills.map(skill => (
            <div class="skill-bar-wrapper">
              <div class="skill-info">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-percent">{skill.level}%</span>
              </div>
              <div class="progress-track">
                <div class="progress-bar progress-bar-emerald" style={`width: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>

        <div class="additional-skills">
          <h4 class="mini-title">Tecnologías</h4>
          <div class="tags-cloud">
            {secondarySkills.map(skill => (
              <span class="tag-item">{skill}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Stats -->
      <div class="stats-showcase fade-up-d1">
        <div class="stats-box-grid">
          {stats.map(stat => (
            <div class="stat-box stat-box-emerald">
              <div class="stat-content">
                <span class="stat-val">{stat.value}</span>
                <span class="stat-lab">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    align-items: center;
  }

  /* Skills Bars */
  .skills-bars {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .skill-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }

  .skill-name {
    font-weight: 600;
    color: white;
    font-size: 1rem;
  }

  .skill-percent {
    color: var(--color-emerald);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .progress-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }

  .progress-bar-emerald {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--color-emerald), #059669);
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
  }

  .additional-skills {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .mini-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .tag-item {
    padding: 8px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
    transition: all 0.3s ease;
  }

  .tag-item:hover {
    color: white;
    border-color: var(--color-emerald);
    background: rgba(16, 185, 129, 0.05);
    transform: translateY(-3px);
  }

  /* Stats Box */
  .stats-box-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .stat-box {
    background: var(--bg-card);
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .stat-box-emerald::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.1), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .stat-box:hover {
    transform: translateY(-10px);
    border-color: var(--color-emerald);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .stat-box:hover::before {
    opacity: 1;
  }

  .stat-content {
    position: relative;
    z-index: 2;
  }

  .stat-val {
    display: block;
    font-size: 2.2rem;
    font-weight: 900;
    color: white;
    margin-bottom: 0.5rem;
  }

  .stat-lab {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .section-tag-emerald {
    color: var(--color-emerald);
  }

  .text-gradient-emerald {
    background: linear-gradient(90deg, var(--color-emerald), #059669);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 992px) {
    .skills-grid { grid-template-columns: 1fr; gap: 4rem; }
    .stats-box-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
