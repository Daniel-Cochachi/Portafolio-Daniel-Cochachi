<div class="whatsapp-container">
  <div class="whatsapp-bubble">
    <div class="bubble-info">
      <span class="bubble-status">Online</span>
      <span class="bubble-text">¡Hola! ¿En qué puedo ayudarte?</span>
    </div>
  </div>
  <a 
    href="https://wa.me/51992530367" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-btn"
    aria-label="Contactar por WhatsApp"
  >
    <svg class="wa-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M12.004 2C6.48 2 2.004 6.477 2.004 12c0 1.767.462 3.427 1.27 4.87l-1.27 4.63 4.75-1.246c1.4.764 2.99 1.2 4.66 1.2 5.524 0 10-4.477 10-10s-4.476-10-9.996-10zM12 20.33c-1.547 0-3.02-.397-4.312-1.09l-.31-.166-2.82.74.752-2.734-.183-.29A8.307 8.307 0 0 1 3.667 12c0-4.595 3.738-8.333 8.333-8.333 4.595 0 8.333 3.738 8.333 8.333s-3.738 8.333-8.333 8.333zm4.568-6.19c-.25-.125-1.478-.73-1.707-.812-.23-.083-.396-.125-.563.125-.167.25-.646.813-.792.98-.146.167-.292.187-.542.062-.25-.125-1.054-.388-2.01-1.24-.742-.662-1.245-1.48-1.39-1.73-.146-.25-.015-.385.11-.51.11-.113.25-.292.375-.438.125-.146.167-.25.25-.417.083-.167.042-.313-.021-.438-.063-.125-.563-1.354-.77-1.854-.203-.49-.407-.424-.563-.432-.146-.007-.313-.008-.48-.008-.166 0-.437.063-.666.313-.23.25-.875.855-.875 2.083s.896 2.417 1.02 2.583c.125.167 1.764 2.693 4.27 3.774.597.257 1.063.41 1.427.527.6.19 1.146.163 1.577.1.48-.073 1.477-.604 1.686-1.187.21-.583.21-1.083.146-1.187-.063-.105-.23-.166-.48-.29z" fill="currentColor"/>
    </svg>
    <span class="btn-ping"></span>
  </a>
</div>

<style>
  .whatsapp-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 1000;
  }

  .whatsapp-bubble {
    background: #ffffff;
    padding: 12px 20px;
    border-radius: 18px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    position: relative;
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .whatsapp-container:hover .whatsapp-bubble {
    opacity: 1;
    transform: translateX(0);
  }

  .bubble-info {
    display: flex;
    flex-direction: column;
  }

  .bubble-status {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #25d366;
    letter-spacing: 1px;
    margin-bottom: 2px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .bubble-status::before {
    content: '';
    width: 6px;
    height: 6px;
    background: #25d366;
    border-radius: 50%;
    display: inline-block;
  }

  .bubble-text {
    color: #1a1f2e;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .whatsapp-btn {
    width: 65px;
    height: 65px;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    position: relative;
    border: none;
    text-decoration: none;
  }

  .wa-svg {
    width: 34px;
    height: 34px;
    position: relative;
    z-index: 2;
  }

  .whatsapp-btn:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 30px rgba(37, 211, 102, 0.6);
  }

  .btn-ping {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #25d366;
    border-radius: 50%;
    z-index: 0;
    opacity: 0.4;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .whatsapp-bubble { display: none; }
    .whatsapp-container { bottom: 20px; right: 20px; }
    .whatsapp-btn { width: 55px; height: 55px; }
    .wa-svg { width: 28px; height: 28px; }
  }
</style>
